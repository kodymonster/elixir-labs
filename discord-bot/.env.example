# Discord bot token: Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Discord application (client) ID: Discord Developer Portal -> your application -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Anthropic API key (for /question): console.anthropic.com -> API Keys. Needs credits on the account to work.
ANTHROPIC_API_KEY=

# Channel ID of your Ticket Tool (or similar) support channel — /support points users here.
# Right-click the channel in Discord (with Developer Mode on) -> Copy Channel ID.
SUPPORT_TICKET_CHANNEL_ID=

# Optional: if set, the bot answers every message in this channel without needing an @mention.
# Right-click the channel in Discord (with Developer Mode on) -> Copy Channel ID.
SUPPORT_CHANNEL_ID=

# Optional: Discord webhook URL for src/webhook.js (posting standalone notifications to a channel).
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Cash App tag payments go to, without the leading $ (e.g. "heehehaaa" for $heehehaaa).
# Used by /buy to build a cash.app/$tag/<price> link for the exact listing price.
CASHAPP_TAG=
